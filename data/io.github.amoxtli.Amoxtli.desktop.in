[Desktop Entry]
Type=Application
Name=Amoxtli
GenericName=Markdown Viewer
GenericName[es]=Visor de Markdown
GenericName[pt_BR]=Visualizador de Markdown
GenericName[fr]=Visionneuse Markdown
GenericName[de]=Markdown-Betrachter
GenericName[it]=Visualizzatore Markdown
GenericName[ru]=Просмотрщик Markdown
GenericName[zh_CN]=Markdown 查看器
GenericName[ja]=Markdown ビューアー
GenericName[ko]=Markdown 뷰어
Comment=Read Markdown documents and folders of notes
Comment[es]=Lee documentos Markdown y carpetas de notas
Comment[pt_BR]=Leia documentos Markdown e pastas de notas
Comment[fr]=Lire des documents Markdown et des dossiers de notes
Comment[de]=Markdown-Dokumente und Notizordner lesen
Comment[it]=Leggi documenti Markdown e cartelle di note
Comment[ru]=Чтение документов Markdown и папок с заметками
Comment[zh_CN]=阅读 Markdown 文档和笔记文件夹
Comment[ja]=Markdown ドキュメントとノートのフォルダーを閲覧します
Comment[ko]=Markdown 문서와 노트 폴더를 읽습니다
Exec=@BINDIR@/amoxtli %U
TryExec=@BINDIR@/amoxtli
Icon=io.github.amoxtli.Amoxtli
Terminal=false
Categories=GNOME;GTK;Office;Viewer;
Keywords=markdown;md;viewer;reader;readme;notes;documentation;
Keywords[es]=markdown;md;visor;lector;readme;notas;documentación;
Keywords[pt_BR]=markdown;md;visualizador;leitor;readme;notas;documentação;
Keywords[fr]=markdown;md;visionneuse;lecteur;readme;notes;documentation;
Keywords[de]=markdown;md;betrachter;leser;readme;notizen;dokumentation;
Keywords[it]=markdown;md;visualizzatore;lettore;readme;note;documentazione;
Keywords[ru]=markdown;md;просмотр;чтение;readme;заметки;документация;
Keywords[zh_CN]=markdown;md;查看器;阅读器;readme;笔记;文档;
Keywords[ja]=markdown;md;ビューアー;リーダー;readme;ノート;ドキュメント;
Keywords[ko]=markdown;md;뷰어;리더;readme;노트;문서;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
StartupWMClass=io.github.amoxtli.Amoxtli
Actions=new-window;

