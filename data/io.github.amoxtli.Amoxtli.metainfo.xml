<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.amoxtli.Amoxtli</id>
  <name>Amoxtli</name>
  <summary>Read Markdown documents natively</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Amoxtli (“book” in Nahuatl) is a fast, native Markdown viewer built with GTK 4 and libadwaita.</p>
    <ul>
      <li>Native rendering — no embedded browser</li>
      <li>Table of contents sidebar with scroll tracking</li>
      <li>Browse whole folders of notes</li>
      <li>Live reload when the file changes</li>
      <li>Tables, task lists, images and syntax-highlighted code</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/k4rmakoma0/amoxtli-linux/main/data/screenshots/light.png</image>
      <caption>A Markdown document with its table of contents</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/k4rmakoma0/amoxtli-linux/main/data/screenshots/dark.png</image>
      <caption>Dark mode with alerts, code and tables</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/k4rmakoma0/amoxtli-linux/main/data/screenshots/folder.png</image>
      <caption>Browsing a folder of notes</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/k4rmakoma0/amoxtli-linux</url>
  <url type="bugtracker">https://github.com/k4rmakoma0/amoxtli-linux/issues</url>
  <launchable type="desktop-id">io.github.amoxtli.Amoxtli.desktop</launchable>
  <provides><mediatype>text/markdown</mediatype></provides>
  <content_rating type="oars-1.1"/>
