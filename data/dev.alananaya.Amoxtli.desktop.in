[Desktop Entry]
Type=Application
Name=Amoxtli
GenericName=Markdown Editor
GenericName[es]=Editor de Markdown
GenericName[pt_BR]=Editor de Markdown
GenericName[fr]=Éditeur Markdown
GenericName[de]=Markdown-Editor
GenericName[it]=Editor Markdown
GenericName[ru]=Редактор Markdown
GenericName[zh_CN]=Markdown 编辑器
GenericName[zh_TW]=Markdown 編輯器
GenericName[ja]=Markdown エディタ
GenericName[ko]=Markdown 편집기
Comment=Write and read Markdown documents and folders of notes
Comment[es]=Escribe y lee documentos Markdown y carpetas de notas
Comment[pt_BR]=Escreva e leia documentos Markdown e pastas de notas
Comment[fr]=Écrire et lire des documents Markdown et des dossiers de notes
Comment[de]=Markdown-Dokumente und Notizordner schreiben und lesen
Comment[it]=Scrivi e leggi documenti Markdown e cartelle di note
Comment[ru]=Создание и чтение документов Markdown и папок с заметками
Comment[zh_CN]=编写和阅读 Markdown 文档和笔记文件夹
Comment[zh_TW]=撰寫和閱讀 Markdown 文件和筆記資料夾
Comment[ja]=Markdown ドキュメントとノートのフォルダーを作成・閲覧します
Comment[ko]=Markdown 문서와 노트 폴더를 작성하고 읽습니다
Exec=@BINDIR@/amoxtli %U
TryExec=@BINDIR@/amoxtli
Icon=dev.alananaya.Amoxtli
Terminal=false
Categories=GNOME;GTK;Utility;TextEditor;
Keywords=markdown;md;editor;writer;viewer;readme;notes;documentation;
Keywords[es]=markdown;md;editor;visor;readme;notas;documentación;
Keywords[pt_BR]=markdown;md;editor;visualizador;readme;notas;documentação;
Keywords[fr]=markdown;md;éditeur;visionneuse;readme;notes;documentation;
Keywords[de]=markdown;md;editor;betrachter;readme;notizen;dokumentation;
Keywords[it]=markdown;md;editor;visualizzatore;readme;note;documentazione;
Keywords[ru]=markdown;md;редактор;просмотр;readme;заметки;документация;
Keywords[zh_CN]=markdown;md;编辑器;查看器;readme;笔记;文档;
Keywords[zh_TW]=markdown;md;編輯器;檢視器;readme;筆記;文件;
Keywords[ja]=markdown;md;エディタ;ビューアー;readme;ノート;ドキュメント;
Keywords[ko]=markdown;md;편집기;뷰어;readme;노트;문서;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
StartupWMClass=dev.alananaya.Amoxtli
Actions=new-window;

